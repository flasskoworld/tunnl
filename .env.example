STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Postgres — Vercel Postgres, Supabase, Neon, or any standard Postgres
DATABASE_URL=postgres://user:password@host:5432/dbname

# Auth — any long random string (openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-string

# Resend (magic-link email) — https://resend.com
RESEND_API_KEY=re_placeholder
MAIL_FROM="TUNNL <onboarding@resend.dev>"

# Base URL for links sent from server contexts (webhooks) where there's
# no browser Origin header. Use your real domain in production.
APP_URL=http://localhost:3000
